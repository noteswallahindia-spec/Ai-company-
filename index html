<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>AI Company</title>

<style>
*{
  box-sizing:border-box;
  margin:0;
  padding:0;
  font-family:Arial,sans-serif;
}

body{
  background:#f5f7fb;
  color:#172033;
}

header{
  background:#111827;
  color:white;
  padding:18px;
  position:sticky;
  top:0;
  z-index:10;
}

header h1{
  font-size:22px;
}

header p{
  color:#9ca3af;
  margin-top:4px;
  font-size:13px;
}

.container{
  max-width:1100px;
  margin:auto;
  padding:20px;
}

.hero{
  background:white;
  border-radius:18px;
  padding:22px;
  margin-bottom:18px;
  box-shadow:0 4px 20px rgba(0,0,0,.06);
}

.hero h2{
  margin-bottom:8px;
}

.stats{
  display:grid;
  grid-template-columns:repeat(4,1fr);
  gap:12px;
  margin-bottom:18px;
}

.stat{
  background:white;
  padding:18px;
  border-radius:15px;
  box-shadow:0 4px 18px rgba(0,0,0,.05);
}

.stat span{
  display:block;
  font-size:13px;
  color:#6b7280;
}

.stat strong{
  display:block;
  font-size:26px;
  margin-top:6px;
}

.section{
  background:white;
  padding:20px;
  border-radius:18px;
  margin-bottom:18px;
  box-shadow:0 4px 18px rgba(0,0,0,.05);
}

.section h3{
  margin-bottom:15px;
}

.agents{
  display:grid;
  grid-template-columns:repeat(5,1fr);
  gap:12px;
}

.agent{
  border:1px solid #e5e7eb;
  border-radius:14px;
  padding:15px;
}

.agent .icon{
  font-size:25px;
  margin-bottom:10px;
}

.agent h4{
  font-size:15px;
}

.status{
  margin-top:8px;
  font-size:12px;
  color:#16a34a;
}

.task{
  display:flex;
  justify-content:space-between;
  align-items:center;
  border-bottom:1px solid #eee;
  padding:13px 0;
}

.task:last-child{
  border-bottom:0;
}

.badge{
  background:#eef2ff;
  color:#4f46e5;
  padding:5px 9px;
  border-radius:20px;
  font-size:11px;
}

button{
  border:0;
  background:#111827;
  color:white;
  padding:11px 16px;
  border-radius:10px;
  cursor:pointer;
}

button:hover{
  opacity:.9;
}

@media(max-width:750px){
  .stats{
    grid-template-columns:repeat(2,1fr);
  }

  .agents{
    grid-template-columns:repeat(2,1fr);
  }
}

@media(max-width:430px){
  .container{
    padding:12px;
  }

  .agents{
    grid-template-columns:1fr 1fr;
  }
}
</style>
</head>

<body>

<header>
  <h1>🤖 AI Company</h1>
  <p>Autonomous AI Development Team</p>
</header>

<main class="container">

  <section class="hero">
    <h2>CEO Control Center</h2>
    <p>
      Manage projects, AI agents, tasks, approvals and company activity
      from one place.
    </p>
    <br>
    <button onclick="createProject()">+ Create Project</button>
  </section>

  <section class="stats">

    <div class="stat">
      <span>Projects</span>
      <strong id="projects">0</strong>
    </div>

    <div class="stat">
      <span>Active Agents</span>
      <strong>5</strong>
    </div>

    <div class="stat">
      <span>Tasks</span>
      <strong id="tasks">0</strong>
    </div>

    <div class="stat">
      <span>Approvals</span>
      <strong id="approvals">0</strong>
    </div>

  </section>

  <section class="section">

    <h3>🤖 AI Team</h3>

    <div class="agents">

      <div class="agent">
        <div class="icon">🎨</div>
        <h4>Builder Agent</h4>
        <div class="status">● Ready</div>
      </div>

      <div class="agent">
        <div class="icon">🗄️</div>
        <h4>Backend Agent</h4>
        <div class="status">● Ready</div>
      </div>

      <div class="agent">
        <div class="icon">🛡️</div>
        <h4>Security Agent</h4>
        <div class="status">● Ready</div>
      </div>

      <div class="agent">
        <div class="icon">🐛</div>
        <h4>QA Agent</h4>
        <div class="status">● Ready</div>
      </div>

      <div class="agent">
        <div class="icon">📦</div>
        <h4>Product Agent</h4>
        <div class="status">● Ready</div>
      </div>

    </div>

  </section>

  <section class="section">

    <h3>📋 Current Tasks</h3>

    <div id="taskList">
      <div class="task">
        <span>Initialize AI Company</span>
        <span class="badge">Foundation</span>
      </div>

      <div class="task">
        <span>Configure Agent System</span>
        <span class="badge">Pending</span>
      </div>
    </div>

  </section>

  <section class="section">

    <h3>🧠 Company Memory</h3>

    <p>
      Central memory will store project information, architecture,
      agent instructions, previous tasks, bugs and release history.
    </p>

  </section>

  <section class="section">

    <h3>🔐 Approval Center</h3>

    <p>
      Major code, database, security and production changes will require
      owner approval before execution.
    </p>

  </section>

</main>

<script>

let projectCount = 0;
let taskCount = 2;
let approvalCount = 0;

function createProject(){

  const name = prompt("Enter project name:");

  if(!name) return;

  projectCount++;
  taskCount += 4;

  document.getElementById("projects").textContent = projectCount;
  document.getElementById("tasks").textContent = taskCount;

  const list = document.getElementById("taskList");

  const task = document.createElement("div");

  task.className = "task";

  task.innerHTML = `
    <span>Create project: ${escapeHTML(name)}</span>
    <span class="badge">Created</span>
  `;

  list.prepend(task);

  alert("Project created successfully.");
}

function escapeHTML(text){

  return text
    .replaceAll("&","&amp;")
    .replaceAll("<","&lt;")
    .replaceAll(">","&gt;")
    .replaceAll('"',"&quot;")
    .replaceAll("'","&#039;");
}

</script>

</body>
</html>
